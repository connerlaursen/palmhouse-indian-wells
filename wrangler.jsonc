{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palmhouse-indian-wells",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "www.indianwells.us",
      "custom_domain": true
    },
    {
      "pattern": "indianwells.us",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "palmhouse-indian-wells",
      "database_id": "f00deec5-f111-4c9f-8c29-f7066819fb6e"
    }
  ]
}
